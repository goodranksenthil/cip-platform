# Store text with LF in the repo and keep LF on checkout (Docker / Render builds run on Linux).
* text=auto eol=lf

# Windows scripts need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Never touch binary content (some generated PDFs look like text; converting them corrupts them)
*.pdf  binary
*.docx binary
*.zip  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
