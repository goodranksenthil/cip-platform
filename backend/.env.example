CIP_DATABASE_URL=postgresql+psycopg://cip:cip_password@localhost:5432/cip_db
CIP_FIELD_ENCRYPTION_KEY=local-dev-only-rotate-me-0123456789
CIP_BLOB_ROOT=./storage/blob
